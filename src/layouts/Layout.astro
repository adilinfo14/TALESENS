---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const {
  title = 'TALESENS — Donner du sens aux marques',
  description = 'Agence de conseil en communication, storytelling et stratégie de marque. Nous accompagnons entreprises, organisations et personnalités dans la création de récits authentiques qui inspirent et créent de l\'impact.',
  image = '/og-image.png',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://talesens.noschoixpourvous.com');
---

<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#0D0F1D" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical.toString()} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical.toString()} />
  <meta property="og:image" content={image} />
  <meta property="og:locale" content="fr_FR" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />

  <!-- Favicon (SVG inline pour rester léger) -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@500;600;700;800&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <a href="#main" class="skip-link">Aller au contenu</a>
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />

  <script is:inline>
    // Reveal on scroll
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -60px 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    } else {
      document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
    }
  </script>
</body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--white-soft);
    color: var(--midnight);
    padding: 0.5rem 1rem;
    border-radius: 0 0 8px 0;
    z-index: 200;
  }
  .skip-link:focus { left: 0; }
</style>
